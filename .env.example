# .env — secrets and machine-specific paths. Copy to `.env`, fill in, `chmod 600 .env`.
# NEVER commit `.env` (it is in .gitignore).

# --- AI providers (roadmap section 10.1; used from phase 2) ---
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- SEC contact line (required by SEC on every request; used from phase 1) ---
# Format: "Your Name your@email.com"
SEC_UA=

# --- Paths (machine-specific) ---
# The Drive root folder `Investing/` on this machine (Google Drive for desktop, "Mirror files").
# Mac example: /Users/<you>/Library/CloudStorage/GoogleDrive-<account>/My Drive/Investing
DRIVE_DIR=
# Optional: where SQLite lives. Default (settings.yaml): ~/investment-agents-data — never inside Drive.
# DATA_DIR=

# --- Telegram ---
# The bot token and your Telegram user ID go into Hermes (`hermes gateway setup`), not into this file.
# Our code never talks to Telegram: it prints text, Hermes delivers it.
